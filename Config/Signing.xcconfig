// SPDX-License-Identifier: GPL-2.0-or-later
//
// Default signing: ad hoc ("-"), so anyone can build and run Studio EQ without an Apple
// developer account (macOS then asks for the audio capture permission again after each build).
//
// To sign with your own identity, copy Local.xcconfig.example to Local.xcconfig (ignored by
// git) and fill it in. Distribution builds (scripts/release.sh) override these settings on the
// xcodebuild command line with a Developer ID identity.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
